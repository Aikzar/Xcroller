{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xcroller",
  "version": "0.2.0",
  "identifier": "com.jens-aerts.xcroller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xcroller",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jens Aerts",
    "shortDescription": "A fast local image and video browser.",
    "longDescription": "Xcroller is a private, high-performance desktop browser for local image and video collections.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
